  m_Script: {fileID: 11500000, guid: 747e6eacf70b91b479f475991cdd4145, type: 3}
  m_Name: PosRecompensa
  m_EditorClassIdentifier: 
  Sentences:
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Ent\xE3o era aqui que estava meu sabre de luz."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Esse brinquedo machuca, n\xE3o sei se gosto dele."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "J\xE1 vi papai brincando usando ele com Mark."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "O problema \xE9 que ele n\xE3o tem um sabre."
