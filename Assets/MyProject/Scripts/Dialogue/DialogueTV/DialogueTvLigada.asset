MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 747e6eacf70b91b479f475991cdd4145, type: 3}
  m_Name: DialogueTvLigada
  m_EditorClassIdentifier: 
  Sentences:
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: "Policial encontrado morto em estacionamento nesta manh\xE3 de ter\xE7a."
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: "Investiga\xE7\xE3o aponta poss\xEDvel execu\xE7\xE3o."
  - ActorData: {fileID: 11400000, guid: f49662f4bd68c504ea037e0575027b62, type: 2}
    content: O que!?
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: "A v\xEDtima, Scott Wilson, era policial h\xE1 15 anos."
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: "Fontes indicam envolvimento em um caso de corrup\xE7\xE3o."
  - ActorData: {fileID: 11400000, guid: f49662f4bd68c504ea037e0575027b62, type: 2}
    content: "CORRUP\xC7\xC3O!? Est\xE3o loucos, Scott nunca... Por Deus Scott...."
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: Ele teria denunciado um esquema interno.
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: "A pol\xEDcia investiga se o assassinato foi um acerto de contas."
  - ActorData: {fileID: 11400000, guid: f49662f4bd68c504ea037e0575027b62, type: 2}
    content: "N\xE3o pode ser..."
  - ActorData: {fileID: 11400000, guid: c0bbdb15d1eced8429e64629c2da4012, type: 2}
    content: "At\xE9 o momento, ningu\xE9m foi preso."
