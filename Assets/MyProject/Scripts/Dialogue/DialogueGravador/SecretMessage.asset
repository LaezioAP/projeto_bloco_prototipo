  m_Script: {fileID: 11500000, guid: 747e6eacf70b91b479f475991cdd4145, type: 3}
  m_Name: SecretMessage
  m_EditorClassIdentifier: 
  Sentences:
  - ActorData: {fileID: 11400000, guid: 7c8e27d203c2a36428a567e34ffd2a3f, type: 2}
    content: Para de beber e me atende cara!
  - ActorData: {fileID: 11400000, guid: 7c8e27d203c2a36428a567e34ffd2a3f, type: 2}
    content: "Se voc\xEA t\xE1 ouvindo isso, deu tudo errado."
  - ActorData: {fileID: 11400000, guid: 7c8e27d203c2a36428a567e34ffd2a3f, type: 2}
    content: Eu tentei fazer a coisa certa. Mas eles sabem.
  - ActorData: {fileID: 11400000, guid: 7c8e27d203c2a36428a567e34ffd2a3f, type: 2}
    content: "T\xE3o me seguindo... se acontecer algo comigo, n\xE3o foi acidente."
  - ActorData: {fileID: 11400000, guid: 7c8e27d203c2a36428a567e34ffd2a3f, type: 2}
    content: "Voc\xEA precisa ser esperto. N\xE3o confia em ningu\xE9m da corpora\xE7\xE3o."
  - ActorData: {fileID: 11400000, guid: 7c8e27d203c2a36428a567e34ffd2a3f, type: 2}
    content: "Se cuida, irm\xE3o."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Isso parece s\xE9rio..."
