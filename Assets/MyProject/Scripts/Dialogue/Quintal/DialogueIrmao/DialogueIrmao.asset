  m_Script: {fileID: 11500000, guid: 747e6eacf70b91b479f475991cdd4145, type: 3}
  m_Name: DialogueIrmao
  m_EditorClassIdentifier: 
  Sentences:
  - ActorData: {fileID: 11400000, guid: 0b50412fcdcf0c04b90441b5fa2a8a50, type: 2}
    content: Que demora Jason!
  - ActorData: {fileID: 11400000, guid: 0b50412fcdcf0c04b90441b5fa2a8a50, type: 2}
    content: Achei que levaria o dia todo para resolver um enigma bobo desses.
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Foi muito f\xE1cil cara."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: Tive que procurar pilha para o papai.
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Ele est\xE1 um pouco bravo."
  - ActorData: {fileID: 11400000, guid: 0b50412fcdcf0c04b90441b5fa2a8a50, type: 2}
    content: "E quando ele n\xE3o est\xE1?"
  - ActorData: {fileID: 11400000, guid: 0b50412fcdcf0c04b90441b5fa2a8a50, type: 2}
    content: "R\xE1pido, n\xE3o temos muito tempo."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Como assim? O dia mal come\xE7ou..."
  - ActorData: {fileID: 11400000, guid: 0b50412fcdcf0c04b90441b5fa2a8a50, type: 2}
    content: "\xC9 apenas uma brincadeira no por\xE3o."
  - ActorData: {fileID: 11400000, guid: 0b50412fcdcf0c04b90441b5fa2a8a50, type: 2}
    content: "Vou depois de voc\xEA."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: Ok!
