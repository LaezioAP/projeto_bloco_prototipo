  m_Name: DialogueMae
  m_EditorClassIdentifier: 
  Sentences:
  - ActorData: {fileID: 11400000, guid: 6860aa2dd54d1094b9dab2c0f189d184, type: 2}
    content: "Bom dia Jason, ainda n\xE3o terminei o caf\xE9."
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Bom dia mam\xE3e, n\xE3o tem problema."
  - ActorData: {fileID: 11400000, guid: 6860aa2dd54d1094b9dab2c0f189d184, type: 2}
    content: "Ah querido, se todos fossem gentis como voc\xEA..."
  - ActorData: {fileID: 11400000, guid: 6860aa2dd54d1094b9dab2c0f189d184, type: 2}
    content: O mundo com certeza seria um lugar melhor.
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "J\xE1 que sou t\xE3o gentil, semana que vem no meu anivers\xE1-"
  - ActorData: {fileID: 11400000, guid: 6860aa2dd54d1094b9dab2c0f189d184, type: 2}
    content: Sim, Jason, eu vou fazer seu bolo de morango.
  - ActorData: {fileID: 11400000, guid: 9940a59d5c0c1894d8976f90b9c1a4f8, type: 2}
    content: "Voc\xEA \xE9 a melhor m\xE3e do mundo!"
